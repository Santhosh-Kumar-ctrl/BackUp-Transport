# Copy to backend/.env and adjust. Defaults work with docker-compose.yml as-is.
DATABASE_URL=postgresql+asyncpg://transit:transit@localhost:5433/transit
TEST_DATABASE_URL=postgresql+asyncpg://transit:transit@localhost:5433/transit_test

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Boarding QR rotates every N seconds; a token is valid for QR_TTL_SECONDS
QR_TTL_SECONDS=30

# Operational thresholds
DELAY_THRESHOLD_MIN=5
CAPACITY_WARN_PCT=90
DELAY_WATCH_INTERVAL_SECONDS=60

# Comma-separated origins allowed to call the API (Flutter web dev server)
CORS_ORIGINS=*
